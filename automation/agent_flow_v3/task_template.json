{
  "schema": "CARE_AGENT_FLOW_V3",
  "enabled": false,
  "task_id": "replace_me",
  "repository": "YuukiAS/CARE_Challenge",
  "integration_branch": "develop",
  "frozen_contract_path": "prompts/tasks/<task>.md",
  "frozen_contract_sha256": null,
  "planner_reentry_required": true,
  "critic_freeze_required": true,
  "controller_executor_separation_required": true,
  "verifier_executor_separation_required": true,
  "role_sessions": {
    "controller": {
      "thread_id_file": "${CARE_AGENT_FLOW_STATE_ROOT}/<task_id>/controller_thread_id",
      "codex_home": "${CARE_CODEX_HOME_ROOT}/CARE_<task_id>_CONTROLLER",
      "worktree": "${CARE_AGENT_FLOW_WORKTREE_ROOT}/<task_id>/controller",
      "local_branch": "local/controller/<task_id>",
      "may_edit_implementation": false,
      "may_edit_verification": false
    },
    "verifier": {
      "thread_id_file": "${CARE_AGENT_FLOW_STATE_ROOT}/<task_id>/verifier_thread_id",
      "codex_home": "${CARE_CODEX_HOME_ROOT}/CARE_<task_id>_VERIFIER",
      "worktree": "${CARE_AGENT_FLOW_WORKTREE_ROOT}/<task_id>/verifier",
      "local_branch": "local/verifier/<task_id>",
      "may_edit_implementation": false,
      "may_edit_verification": true
    },
    "executor": {
      "thread_id_file": "${CARE_AGENT_FLOW_STATE_ROOT}/<task_id>/executor_thread_id",
      "codex_home": "${CARE_CODEX_HOME_ROOT}/CARE_<task_id>_EXECUTOR",
      "worktree": "${CARE_AGENT_FLOW_WORKTREE_ROOT}/<task_id>/executor",
      "local_branch": "local/executor/<task_id>",
      "may_edit_implementation": true,
      "may_edit_verification": false
    }
  },
  "critical_paths": [
    "prompts/blueprints/**",
    "src/**",
    "scripts/training/**",
    "scripts/inference/**",
    "jobs/**",
    "configs/**",
    "tests/**",
    "validators/**"
  ],
  "max_repair_rounds": 12,
  "human_gate_after_planner_pass": true,
  "training_authorized": false,
  "outer_access_authorized": false,
  "deployment_authorized": false,
  "created_utc": null
}
