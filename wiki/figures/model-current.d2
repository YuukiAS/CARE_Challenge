direction: right

inputs: "LGE/T2/C0 + availability" {
  shape: rectangle
}
stems: "3 modality stems; 8 channels each; hard mask" {
  shape: rectangle
}
resenc: "ResidualEncoderUNet M; official dynamic_network_architectures" {
  shape: rectangle
}
heads: "anatomy + scar + edema heads" {
  shape: rectangle
}
logits: "six-class final logits [bg,myo,LV,RV,edema,scar]" {
  shape: rectangle
}
eval: "44-case fixed checkpoint reload/eval; no usable signal" {
  shape: rectangle
}
historical: "Historical SRR / BR2 / SIP / refiner / gate; not called in Batch9" {
  shape: rectangle
  style.stroke-dash: 4
}

inputs -> stems: observed modalities only
stems -> resenc: fused features + availability channels
resenc -> heads: decoder features
heads -> logits: composed final margins
logits -> eval: selected endpoint predictions
historical -> eval: disabled boundary
