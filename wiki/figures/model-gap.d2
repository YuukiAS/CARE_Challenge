vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

title: "CARE current vs target gap"
meta: "version: care-agent-flow-v2-complete\nreview: M9 follow-up no-promotion\nfingerprint: wiki+validator+skills+toolkit" {
  style.fill: "#ffffff"
  style.stroke: "#6b7280"
}
legend: "Legend\nsolid: target expectation\ndashed: current gap to close\npurple: Cine secondary line" {
  style.fill: "#ffffff"
  style.stroke: "#6b7280"
}

target: {
  label: "SRR-v3 target"
  availability: "availability-aware retrieval"
  dictionary: "semantic bank + train/OOF prototypes"
  proposal: "anatomy-guided proposal"
  refiner: "pathology-specific soft ROI"
  losses: "explicit objectives"
  cine: "registration-aware temporal retrieval"
}

current: {
  label: "Current audited state"
  myops: "M9 formal candidates\nnegative vs M8 nnU-Net anchor"
  evidence: "follow-up packet reconciled\nready/no-promotion audited"
  gaps: "component effect and Cine temporal\nneed mapper-final closure"
}

target -> current: "gaps must be closed with runtime evidence" {
  style.stroke-dash: 4
}
meta -> target: "context"
legend -> current: "style key"
