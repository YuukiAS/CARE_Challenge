# ------------------------------------------------------------------------------
# Data
# ------------------------------------------------------------------------------
results/checkpoints/
results/predictions/

# Large task/pilot output trees. Keep lightweight task-scoped bridge artifacts
# under results/<task_key>/ tracked, but ignore bulky domain outputs.
results/cinema_adapter/
results/experiments/*/

# Fetched CARE2026 leaderboard snapshots (CSV + JSON from fetch_care2026_scores.py)
results/leaderboard/care2026_*.csv
results/leaderboard/care2026_*.json

# Local validation submission workspaces (zips, prediction trees). Keep only
# lightweight README policy files under results/submissions tracked.
results/submissions/**
!results/submissions/
!results/submissions/README.md
!results/submissions/care_myocardium_validation/
!results/submissions/care_myocardium_validation/README.md

# Generated local metric variants and drill-down tables. Keep canonical metrics
# tracked explicitly; ignore ad-hoc checkpoint/model comparison outputs.
results/diagnostics/
results/metrics/unified/CineMyoPS_*/
results/metrics/unified/MyoPS-Net_*/
results/metrics/unified/U-MyoPS_*/
results/metrics/unified/*_model_best/
results/metrics/unified/*_model_final_checkpoint/
results/metrics/unified/*/fold_*/modality_group_metrics.json
results/metrics/unified/*/fold_*/modality_group_metrics.md
results/metrics/unified/*/fold_*/hd_per_class.json
results/metrics/unified/*/fold_*/hd95_per_class.json

# Task-scoped experiment directories should keep summaries/manifests tracked but
# not heavy rerunnable artifacts.
results/*/variants/*/checkpoints/
results/*/variants/*/predictions/
results/*/**/checkpoints/
results/*/**/predictions/
results/*/preflight/
results/**/*.pt
results/**/*.pth
results/**/*.ckpt
results/**/*.nii.gz
results/*/coordinator/*.log

# LaTeX presentation build artifacts. Keep source .tex and final .pdf tracked.
docs/presentation/*.aux
docs/presentation/*.log
docs/presentation/*.out
docs/presentation/*.toc
docs/presentation/*.fls
docs/presentation/*.fdb_latexmk
docs/presentation/*.synctex.gz
