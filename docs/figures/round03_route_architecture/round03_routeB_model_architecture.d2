direction: right
layout: dagre

# Route B Round03 model architecture in aligned six-panel template

classes: {
  tensor: {
    style: { fill: "#eef6ff"; stroke: "#245e9c"; stroke-width: 2 }
  }
  verified: {
    style: { fill: "#e7f6e8"; stroke: "#1f7a3b"; stroke-width: 3 }
  }
  smoke: {
    style: { fill: "#e9f2ff"; stroke: "#2364aa"; stroke-width: 2; stroke-dash: 6 }
  }
  planned: {
    style: { fill: "#fff6d8"; stroke: "#b07a00"; stroke-width: 2; stroke-dash: 6 }
  }
  blocked: {
    style: { fill: "#ffe8e8"; stroke: "#b42318"; stroke-width: 3 }
  }
  stale: {
    style: { fill: "#f1f1f1"; stroke: "#777777"; stroke-width: 2; stroke-dash: 6 }
  }
  boundary: {
    style: { fill: "#f3e8ff"; stroke: "#7e22ce"; stroke-width: 2; stroke-dash: 4 }
  }
  panel: {
    style: { fill: "#fbfbfb"; stroke: "#b8b8b8"; stroke-width: 1 }
  }
}


p1: {
  label: "Panel 1 - Inputs"
  class: panel
  x: "MyoPS x [B,3,Z,H,W]\nmodality order [LGE,T2,C0]\navailability [B,3]\nzero fill is not availability\nanchor_logits [B,6,Z,H,W]"
  x.class: tensor
}
p2: {
  label: "Panel 2 - Trunk / Encoder"
  class: panel
  trunk: "RouteBRound03MyoPS\nstems: Conv3d 1->32 each\ndown pyramid [32,64,128,256]\nExpertScale x4"
  trunk.class: smoke
}
p3: {
  label: "Panel 3 - Routing / Proposal / Prototype"
  class: panel
  router: "Expert router\n16 experts per scale\n4 shared + 6 private + 6 pair\ninput: feature + avail emb\n+ anchor/proposal ctx\ninvalid logits -1e4\ntorch.softmax"
  proto: "OfflinePrototypeBank\nscar pos/neg 8/12\nedema pos/safe-neg 8/12\nOOF source string only\nformal B4 not run"
  entmax: "SRR-v3 target\nentmax/top scheduling\nPattern-SIP mass/floor\nnot verified in B3"
  router.class: smoke
  proto.class: smoke
  entmax.class: planned
}
p4: {
  label: "Panel 4 - ROI / Refinement / Composition"
  class: panel
  roi: "anatomy_head 4 logits\nanchor probability context\nscar_proposal, edema_proposal\nscar_roi, edema_roi*T2"
  refine: "scar_refiner\nedema_refiner*T2\nbounded 4*tanh deltas\ncomposition gate 12->16->1\nfinal_logits [B,6,Z,H,W]"
  no_t2: "no-T2 edema exact-zero\nno_t2_edema_delta_abs_max checked"
  roi.class: smoke
  refine.class: smoke
  no_t2.class: verified
}
p5: {
  label: "Panel 5 - CineMA / Registration / Temporal"
  class: panel
  cine: "RouteBRound03CineMAAdapter\nlogits/probabilities\ndecoder_feature_32\nprojected features\nentropy\nB2 smoke only"
  control: "MatchedRandomCineMASource\nB7 formal control\nnot executed in Round03"
  reg: "RouteBRound03SVFRegistration\nvelocity -> 7-step displacement\nwarp + jacobian receipt\nB8 formal evidence not run"
  temp: "TemporalEvidence consumer\nrequired registered fields\n8 learned slots\nB9 final-output rows not run"
  cine.class: smoke
  control.class: planned
  reg.class: planned
  temp.class: planned
}
p6: {
  label: "Panel 6 - Final Output Evidence / Review"
  class: panel
  b3: "B3 terminal gate\n43003 steps; 1800.8 s\n22 validations\nfailed anatomy_union_overfit\nnot full route negative"
  smoke: "B2 final-logit smoke\nchanged_logit_l1=0.086838\nno formal B6 ablation"
  review: "ROUTE_B_ROUND03_REVIEW_ADEQUATE_NEGATIVE"
  auth: "No validation upload\nNo route promotion\nNo hosted metric claim\nNo final scientific decision"
  b3.class: blocked
  smoke.class: smoke
  review.class: blocked
  auth.class: boundary
}

p1.x -> p2.trunk -> p3.router -> p4.roi -> p4.refine -> p6.smoke -> p6.b3 -> p6.review
p3.proto -> p4.roi
p3.entmax -> p6.b3: { style.stroke-dash: 6; style.stroke: "#b07a00" }
p5.cine -> p5.control -> p5.reg -> p5.temp -> p6.b3: { style.stroke-dash: 6; style.stroke: "#b07a00" }
p6.review -> p6.auth: { style.stroke-dash: 4; style.stroke: "#7e22ce" }


legend: {
  label: "Status legend"
  direction: down
  v: "green solid\nimplemented + reviewer verified"
  s: "blue dashed\nimplemented / smoke only"
  p: "yellow dashed\nplanned or not executed"
  b: "red solid\nblocked / adequate negative"
  g: "gray dashed\nstale historical"
  a: "purple dashed\nauthority boundary"
  v.class: verified
  s.class: smoke
  p.class: planned
  b.class: blocked
  g.class: stale
  a.class: boundary
}
