direction: right
layout: dagre

# Round03 Route B vs Route C aligned technical model gap

classes: {
  tensor: {
    style: { fill: "#eef6ff"; stroke: "#245e9c"; stroke-width: 2 }
  }
  verified: {
    style: { fill: "#e7f6e8"; stroke: "#1f7a3b"; stroke-width: 3 }
  }
  smoke: {
    style: { fill: "#e9f2ff"; stroke: "#2364aa"; stroke-width: 2; stroke-dash: 6 }
  }
  planned: {
    style: { fill: "#fff6d8"; stroke: "#b07a00"; stroke-width: 2; stroke-dash: 6 }
  }
  blocked: {
    style: { fill: "#ffe8e8"; stroke: "#b42318"; stroke-width: 3 }
  }
  stale: {
    style: { fill: "#f1f1f1"; stroke: "#777777"; stroke-width: 2; stroke-dash: 6 }
  }
  boundary: {
    style: { fill: "#f3e8ff"; stroke: "#7e22ce"; stroke-width: 2; stroke-dash: 4 }
  }
  panel: {
    style: { fill: "#fbfbfb"; stroke: "#b8b8b8"; stroke-width: 1 }
  }
}


p1: {
  label: "Panel 1 - Inputs"
  class: panel
  b: "B actual\nMyoPS [B,3,Z,H,W]\n[LGE,T2,C0] + availability\nanchor/proposal ctx"
  c: "C actual\nMyoPS + cine evidence\nregistered frame inputs\nanchor/component ctx"
  b.class: smoke
  c.class: verified
}
p2: {
  label: "Panel 2 - Trunk / Encoder"
  class: panel
  b: "B potential\nstems + [32,64,128,256]\n16-expert scales\nformal evidence stops at B3"
  c: "C verified\nSRR prop-refine trunk\nCine adapter\nRegistrationUNet\nTemporal dict encoder"
  b.class: smoke
  c.class: verified
}
p3: {
  label: "Panel 3 - Routing / Proposal / Prototype"
  class: panel
  b: "B boundary\nmasked softmax router smoke\nprototype bank smoke\nPattern-SIP target not verified\nB4 OOF not run"
  c: "C verified\nprototype swap harmful\nzero-effect controls clean\nproposal dictionary affects final path"
  b.class: planned
  c.class: verified
}
p4: {
  label: "Panel 4 - ROI / Refinement / Composition"
  class: panel
  b: "B boundary\nanatomy gate failed\nscar/edema refiners code exists\nB5/B6 not run\nno formal final ablation"
  c: "C verified\nROI prior + crop refiners\nbounded residual/arbitration\nfinal logits/labels changed"
  b.class: blocked
  c.class: verified
}
p5: {
  label: "Panel 5 - CineMA / Registration / Temporal"
  class: panel
  b: "B boundary\nCineMA smoke only\nmatched random B7 not run\nregistration B8 not run\ntemporal B9 not run"
  c: "C verified\nofficial CineMA + random control\nSVF/Jacobian/SyN\nregistered temporal fusion\n12 final-output rows"
  b.class: planned
  c.class: verified
}
p6: {
  label: "Panel 6 - Authorized Conclusion"
  class: panel
  b: "Route B conclusion\nadequate B3 negative\nnot complete route negative\ndownstream modules unjudged"
  c: "Route C conclusion\nevidence-complete packet\nnot route promotion\nnot final scientific decision"
  auth: "Shared blocked actions\nvalidation upload\nroute promotion\nhosted metric claim\nM11 / final decision"
  b.class: blocked
  c.class: verified
  auth.class: boundary
}

p1.b -> p2.b -> p3.b -> p4.b -> p5.b -> p6.b: { style.stroke: "#b42318" }
p1.c -> p2.c -> p3.c -> p4.c -> p5.c -> p6.c: { style.stroke: "#1f7a3b" }
p6.b -> p6.auth: { style.stroke-dash: 4; style.stroke: "#7e22ce" }
p6.c -> p6.auth: { style.stroke-dash: 4; style.stroke: "#7e22ce" }


legend: {
  label: "Status legend"
  direction: down
  v: "green solid\nimplemented + reviewer verified"
  s: "blue dashed\nimplemented / smoke only"
  p: "yellow dashed\nplanned or not executed"
  b: "red solid\nblocked / adequate negative"
  g: "gray dashed\nstale historical"
  a: "purple dashed\nauthority boundary"
  v.class: verified
  s.class: smoke
  p.class: planned
  b.class: blocked
  g.class: stale
  a.class: boundary
}
