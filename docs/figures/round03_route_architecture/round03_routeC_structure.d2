direction: right

classes: {
  verified: {
    style.fill: "#DDEFE4"
    style.stroke: "#2E7D32"
    style.stroke-width: 3
  }
  smoke: {
    style.fill: "#EAF3FA"
    style.stroke: "#2D6F9F"
    style.stroke-dash: 5
  }
  planned: {
    style.fill: "#FFF4D6"
    style.stroke: "#B78300"
    style.stroke-dash: 7
  }
  blocked: {
    style.fill: "#F8DFDE"
    style.stroke: "#B3261E"
    style.stroke-width: 3
  }
  stale: {
    style.fill: "#ECECEC"
    style.stroke: "#777777"
    style.stroke-dash: 4
  }
  boundary: {
    style.fill: "#F4E8FF"
    style.stroke: "#6A3FA0"
    style.stroke-dash: 3
  }
}

title: "Route C Round03 Architecture State"

legend: {
  label: "Legend"
  v: "implemented + reviewer verified"
  v.class: verified
  s: "implemented / smoke evidenced, not final claim"
  s.class: smoke
  p: "planned / scaffolded / unexecuted"
  p.class: planned
  b: "blocked / needs revision"
  b.class: blocked
  h: "stale historical evidence"
  h.class: stale
  a: "forbidden authority boundary"
  a.class: boundary
}

myops: {
  label: "R1 MyoPS Evidence Chain"
  c0: "C0/C0B fingerprint and recovery map"
  replay: "fresh all-checkpoint replay\nraw output manifest + selector"
  prototypes: "proposal prototype banks\npositive/negative real buffers"
  swap: "positive/negative prototype swap\n88 rows, harmful detected"
  controls: "no-op + anchor residual off\nzero-effect controls"
  interventions: "D2/D3 interventions\nlogit / voxel / component deltas"
  validators: "strict R1 and final validators\nknown-bad fixtures PASS"
  c0 -> replay -> prototypes -> swap -> interventions -> validators
  controls -> validators
  c0.class: verified
  replay.class: verified
  prototypes.class: verified
  swap.class: verified
  controls.class: verified
  interventions.class: verified
  validators.class: verified
}

cinema: {
  label: "R2 CineMA Fidelity"
  official: "official CineMA source\nrepo commit + HF revision + MIT license"
  weight: "weight SHA256\nc7a60195e6c0aa..."
  logits: "real logits / probabilities\nfeatures / entropy"
  random: "matched random control\ndistinct source hashes, matched downstream contract"
  smoke: "official preprocessing + implementation tests"
  official -> weight -> logits -> random -> smoke
  official.class: verified
  weight.class: verified
  logits.class: verified
  random.class: verified
  smoke.class: verified
}

registration: {
  label: "R3 Registration"
  svf: "learned SVF\n7-step scaling and squaring"
  jac: "true Jacobian\ninverse consistency"
  syn: "real SyN control"
  pairs: "60 pair receipts\n12/12 case gate PASS"
  receipts: "registration adequacy and finalizer receipts"
  svf -> jac -> syn -> pairs -> receipts
  svf.class: verified
  jac.class: verified
  syn.class: verified
  pairs.class: verified
  receipts.class: verified
}

temporal: {
  label: "R3 Registered Temporal Fusion"
  inputs: "registered logits/features/uncertainty\nvelocity/displacement/Jacobian/motion"
  extras: "texture residual\nframe quality / temporal position / valid masks"
  dictionary: "8-slot temporal dictionary"
  output: "12 temporal final-output rows\nchanged logits / voxels / components"
  inputs -> extras -> dictionary -> output
  inputs.class: verified
  extras.class: verified
  dictionary.class: verified
  output.class: verified
}

review: {
  label: "Final Review State"
  controller: "controller packet complete\nfresh repair job 59530203 completed"
  stale_delta: "architecture_delta_final.md says needs evidence\nsuperseded by latest review"
  finalizer: "R3 runtime job 59501370\nfinalizer job 59501378 PASS"
  reviewer: "ROUTE_C_ROUND03_REVIEW_EVIDENCE_COMPLETE"
  limits: "no validation upload\nno route promotion\nno final scientific decision"
  controller -> finalizer -> reviewer -> limits
  stale_delta -> reviewer: "stale historical conflict"
  controller.class: verified
  stale_delta.class: stale
  finalizer.class: verified
  reviewer.class: verified
  limits.class: boundary
}

myops.validators -> review.controller
cinema.smoke -> registration.svf
registration.receipts -> temporal.inputs
temporal.output -> review.finalizer
