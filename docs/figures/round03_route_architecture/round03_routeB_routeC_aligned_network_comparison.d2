direction: right
layout: dagre

# Round03 Route B and Route C aligned network comparison

classes: {
  tensor: {
    style: { fill: "#eef6ff"; stroke: "#245e9c"; stroke-width: 2 }
  }
  verified: {
    style: { fill: "#e7f6e8"; stroke: "#1f7a3b"; stroke-width: 3 }
  }
  smoke: {
    style: { fill: "#e9f2ff"; stroke: "#2364aa"; stroke-width: 2; stroke-dash: 6 }
  }
  planned: {
    style: { fill: "#fff6d8"; stroke: "#b07a00"; stroke-width: 2; stroke-dash: 6 }
  }
  blocked: {
    style: { fill: "#ffe8e8"; stroke: "#b42318"; stroke-width: 3 }
  }
  stale: {
    style: { fill: "#f1f1f1"; stroke: "#777777"; stroke-width: 2; stroke-dash: 6 }
  }
  boundary: {
    style: { fill: "#f3e8ff"; stroke: "#7e22ce"; stroke-width: 2; stroke-dash: 4 }
  }
  panel: {
    style: { fill: "#fbfbfb"; stroke: "#b8b8b8"; stroke-width: 1 }
  }
}


p1: {
  label: "Panel 1 - Inputs"
  class: panel
  b: "Route B\nMyoPS x [B,3,Z,H,W]\n[LGE,T2,C0]\navailability [B,3]\nanchor/proposal ctx"
  c: "Route C\nMyoPS volumes\nshape not explicit in code\ncine frames + anchor ctx\nregistered frame inputs"
  b.class: tensor
  c.class: tensor
}

p2: {
  label: "Panel 2 - Trunk / Encoder"
  class: panel
  b: "B trunk\n3 modality stems\nConv3d 1->32\npyramid [32,64,128,256]\nExpertScale x4"
  c: "C trunks\nSRRProposeRefineMyoPS\nmodality encoder/retrieval\nCineMA adapter stem\nRegistrationUNet enc/dec\nTemporal dict encoder"
  b.class: smoke
  c.class: verified
}

p3: {
  label: "Panel 3 - Routing / Proposal / Prototype"
  class: panel
  b: "B candidate selection\n16 experts/scale\nshared/private/pair families\nmask invalid logits -1e4\ntorch.softmax\nOfflinePrototypeBank 8/12"
  c: "C candidate selection\nPrototypeBank pos/neg\nT2-safe edema negatives\nProposalDictionary\npos-neg + evidence + ROI\nmatched random control"
  b.class: smoke
  c.class: verified
}

p4: {
  label: "Panel 4 - ROI / Refinement / Composition"
  class: panel
  b: "B final branch\nanatomy_head 4 logits\nscar_roi / edema_roi*T2\nscar_refiner, edema_refiner\ngate Conv3d 12->16->1\nanchor + bounded deltas"
  c: "C final branch\nAnatomyDistanceROIPrior\nP_union/P_LV/P_RV\nCropSoftROIRefinementHead\nresidual + arbitration gates\nprop-refine logits/labels"
  b.class: smoke
  c.class: verified
}

p5: {
  label: "Panel 5 - CineMA / Registration / Temporal"
  class: panel
  b: "B cine lane\nCineMA official smoke\nmatched random B7 not run\nSVF 7-step smoke\nformal B8 not run\nregistered temporal B9 not run"
  c: "C cine lane\nofficial CineMA provenance\nlogits/probs/features/entropy\nRegistrationUNet -> SVF\n7-step disp/warp/Jacobian\nreal SyN control\n8-slot TemporalSlotDictionary\nCineTemporalModel"
  b.class: planned
  c.class: verified
}

p6: {
  label: "Panel 6 - Final Output Evidence / Review"
  class: panel
  b: "B evidence boundary\nB3 formal warmup\n43003 steps, 1800.8 s\n22 validations\nanatomy_union_overfit=false\nB4-B9 not executed\nROUTE_B...ADEQUATE_NEGATIVE"
  c: "C evidence boundary\nR1 swap 88 rows changed\nR2 official CineMA verified\nR3 60 reg receipts\n12 temporal rows changed\nROUTE_C...EVIDENCE_COMPLETE"
  auth: "Forbidden authority boundary\nno validation upload\nno route promotion\nno hosted metric claim\nno final scientific decision"
  stale: "Route C stale conflict\narchitecture_delta_final.md\nsuperseded by review.md"
  b.class: blocked
  c.class: verified
  auth.class: boundary
  stale.class: stale
}

p1.b -> p2.b -> p3.b -> p4.b -> p5.b -> p6.b: { style.stroke: "#2364aa" }
p1.c -> p2.c -> p3.c -> p4.c -> p5.c -> p6.c: { style.stroke: "#1f7a3b" }
p6.b -> p6.auth: { style.stroke: "#7e22ce"; style.stroke-dash: 4 }
p6.c -> p6.auth: { style.stroke: "#7e22ce"; style.stroke-dash: 4 }
p6.stale -> p6.c: { style.stroke: "#777777"; style.stroke-dash: 6 }


legend: {
  label: "Status legend"
  direction: down
  v: "green solid\nimplemented + reviewer verified"
  s: "blue dashed\nimplemented / smoke only"
  p: "yellow dashed\nplanned or not executed"
  b: "red solid\nblocked / adequate negative"
  g: "gray dashed\nstale historical"
  a: "purple dashed\nauthority boundary"
  v.class: verified
  s.class: smoke
  p.class: planned
  b.class: blocked
  g.class: stale
  a.class: boundary
}
