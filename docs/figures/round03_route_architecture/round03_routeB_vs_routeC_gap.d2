direction: right

classes: {
  verified: {
    style.fill: "#DDEFE4"
    style.stroke: "#2E7D32"
    style.stroke-width: 3
  }
  smoke: {
    style.fill: "#EAF3FA"
    style.stroke: "#2D6F9F"
    style.stroke-dash: 5
  }
  planned: {
    style.fill: "#FFF4D6"
    style.stroke: "#B78300"
    style.stroke-dash: 7
  }
  blocked: {
    style.fill: "#F8DFDE"
    style.stroke: "#B3261E"
    style.stroke-width: 3
  }
  stale: {
    style.fill: "#ECECEC"
    style.stroke: "#777777"
    style.stroke-dash: 4
  }
  boundary: {
    style.fill: "#F4E8FF"
    style.stroke: "#6A3FA0"
    style.stroke-dash: 3
  }
}

title: "Round03 Route B vs Route C Gap"

shared: {
  label: "Shared Target"
  srr: "SRR-v3 objective\navailability-aware retrieval + proposal/refiner + Cine temporal"
  metrics: "leaderboard-facing targets\nmyops_scar / myops_edema / myocardium_cinemyops"
  boundaries: "reviewer evidence only\nno route promotion or upload"
  srr -> metrics -> boundaries
  srr.class: planned
  metrics.class: boundary
  boundaries.class: boundary
}

route_b: {
  label: "Route B Round03"
  b_impl: "B0-B2 implemented / smoke evidenced"
  b_b3: "B3 formal warmup\nadequate runtime and accounting"
  b_fail: "anatomy_union_overfit=false\nB3 adequate negative"
  b_missing_myops: "B4-B6 proposal/refiner/joint\nnot executed"
  b_missing_cine: "B7-B9 CineMA control / registration / temporal\nnot executed"
  b_round4: "Round04 contract repairs gate\nplanning still not controller-ready"
  b_review: "review token\nROUTE_B_ROUND03_REVIEW_ADEQUATE_NEGATIVE"
  b_impl -> b_b3 -> b_fail -> b_review
  b_fail -> b_missing_myops
  b_fail -> b_missing_cine
  b_review -> b_round4
  b_impl.class: smoke
  b_b3.class: verified
  b_fail.class: blocked
  b_missing_myops.class: planned
  b_missing_cine.class: planned
  b_round4.class: planned
  b_review.class: verified
}

route_c: {
  label: "Route C Round03"
  c_r1: "R1 replay + interventions\nknown-bad swap repaired"
  c_r2: "R2 real CineMA provenance\nmatched random control"
  c_r3: "R3 registration + temporal chain\nterminal accounting PASS"
  c_review: "review token\nROUTE_C_ROUND03_REVIEW_EVIDENCE_COMPLETE"
  c_stale: "architecture_delta_final.md conflict\nstale historical"
  c_limit: "evidence-complete for portfolio reconciliation\nnot a route promotion"
  c_r1 -> c_r2 -> c_r3 -> c_review -> c_limit
  c_stale -> c_review
  c_r1.class: verified
  c_r2.class: verified
  c_r3.class: verified
  c_review.class: verified
  c_stale.class: stale
  c_limit.class: boundary
}

gap: {
  label: "Main Gap"
  need_b: "Route B needs Round04 critic-ready repair\nthen B0-B10 controller execution"
  use_c: "Route C can serve as evidence-complete architecture basis\nfor planner/reviewer reconciliation"
  compare: "Do not compare B planned modules to C verified evidence\nseparate planned contract from runtime proof"
  need_b -> compare
  use_c -> compare
  need_b.class: planned
  use_c.class: verified
  compare.class: boundary
}

shared.srr -> route_b.b_impl
shared.srr -> route_c.c_r1
route_b.b_review -> gap.need_b
route_c.c_review -> gap.use_c
