direction: right

classes: {
  verified: { style.fill: "#DDEFE4"; style.stroke: "#2E7D32"; style.stroke-width: 3 }
  smoke: { style.fill: "#EAF3FA"; style.stroke: "#2D6F9F"; style.stroke-dash: 5 }
  planned: { style.fill: "#FFF4D6"; style.stroke: "#B78300"; style.stroke-dash: 7 }
  blocked: { style.fill: "#F8DFDE"; style.stroke: "#B3261E"; style.stroke-width: 3 }
  boundary: { style.fill: "#F4E8FF"; style.stroke: "#6A3FA0"; style.stroke-dash: 3 }
}

title: "Route B Round03 Actual vs SRR-v3 Target"

legend: {
  label: "Status legend"
  v: "reviewer verified"
  v.class: verified
  s: "smoke evidenced"
  s.class: smoke
  p: "not executed target"
  p.class: planned
  b: "blocking negative"
  b.class: blocked
}

actual: {
  label: "Round03 actual evidence"
  b0: "B0 manifests\nsource probe"
  b1: "B1 code scaffold\n4 scales, 16 experts"
  b2: "B2 smoke\nforward gradients export"
  b3: "B3 train gate\nformal warmup"
  b3fail: "B3 failure\nanatomy union"
  b10: "B10 accounting\nvalidator PASS"
  review: "ROUTE_B_ROUND03\nREVIEW_ADEQUATE_NEGATIVE"
  b0 -> b1 -> b2 -> b3 -> b3fail -> b10 -> review
  b0.class: verified
  b1.class: smoke
  b2.class: smoke
  b3.class: verified
  b3fail.class: blocked
  b10.class: verified
  review.class: verified
}

round03_code: {
  label: "Implemented forward path"
  input: "[B,3,Z,H,W]\n+ availability [B,3]"
  router: "masked softmax router\navailability aware"
  anatomy: "anatomy_head\nB3 gate target"
  props: "prototype proposals\nscar and edema"
  refiners: "bounded refiners\nsmoke only"
  final: "final_logits changed\nB2 smoke"
  input -> router -> anatomy
  router -> props -> refiners -> final
  input.class: smoke
  router.class: verified
  anatomy.class: blocked
  props.class: smoke
  refiners.class: smoke
  final.class: smoke
}

target: {
  label: "Full SRR-v3 target"
  entmax: "two-pass router\nentmax/top schedule"
  psip: "Pattern-SIP\nmass and floor loss"
  repair: "anatomy repair\nunion/LV/RV"
  oof: "OOF prototypes\nhard negatives"
  b4: "B4 proposal train"
  b5: "B5 refiners"
  b6: "B6 selector eval\n44-case help/harm"
  b7: "B7 CineMA\nmatched random"
  b8: "B8 registration\nSVF plus SyN"
  b9: "B9 registered temporal\nfinal-output rows"
  entmax -> psip -> repair -> oof -> b4 -> b5 -> b6
  b7 -> b8 -> b9
  entmax.class: planned
  psip.class: planned
  repair.class: planned
  oof.class: planned
  b4.class: planned
  b5.class: planned
  b6.class: planned
  b7.class: planned
  b8.class: planned
  b9.class: planned
}

gap: {
  label: "What Round03 cannot judge"
  no_b4: "no B4-B6 terminal MyoPS evidence"
  no_cine: "no B7-B9 terminal Cine evidence"
  no_full_negative: "not full route negative"
  no_upload: "no upload or promotion"
  no_b4 -> no_full_negative
  no_cine -> no_full_negative -> no_upload
  no_b4.class: planned
  no_cine.class: planned
  no_full_negative.class: boundary
  no_upload.class: boundary
}

actual.b3fail -> target.repair: "Round04 repair target"
actual.b3fail -> gap.no_b4
actual.b3fail -> gap.no_cine
round03_code.final -> gap.no_b4: "smoke effect only"
