{
  "enabled_routes": [
    "main"
  ],
  "poll_seconds": 60,
  "repo_root": "${CARE_REPO_ROOT}",
  "codex_runtime_root": "${CARE_CODEX_RUNTIME_ROOT}",
  "codex_home_root": "${CARE_CODEX_HOME_ROOT}",
  "state_path": "controller_notifications/state/notified_goals.json",
  "email": {
    "from": "${CARE_NOTIFY_FROM}",
    "to": [
      "${CARE_NOTIFY_TO}"
    ],
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 587,
    "starttls": true,
    "subject_prefix": "[CARE]",
    "body_format": "plain_plus_html",
    "max_important_slurm_jobs": 6
  },
  "routes": {
    "main": {
      "label": "Main",
      "tmux_target": "",
      "runtime_home_candidates": [
        "CARE__codex-controller",
        "CARE__codex-care",
        "${CARE_CODEX_HOME_ROOT}"
      ],
      "packet_paths": [],
      "notification_brief_paths": [
        "results/*/notification_brief.json"
      ],
      "require_notification_brief": true
    },
    "route_A": {
      "label": "Route A",
      "tmux_target": "${CARE_ROUTE_A_TMUX_TARGET}",
      "runtime_home_candidates": [
        "route_A_tmux_care_route_A__care_route_A",
        "route_A_tmux_care_route_A_controller__care_route_A_controller"
      ],
      "packet_paths": [
        "${CARE_ROUTE_WORKTREE_ROOT}/route_A/results/route_A/controller_report.md",
        "${CARE_ROUTE_WORKTREE_ROOT}/route_A/results/route_A/completion_check.md"
      ]
    },
    "route_B": {
      "label": "Route B",
      "tmux_target": "${CARE_ROUTE_B_TMUX_TARGET}",
      "runtime_home_candidates": [
        "route_B_tmux_care_route_B__care_route_B",
        "route_B_tmux_care_route_B_controller__care_route_B_controller"
      ],
      "packet_paths": [
        "${CARE_ROUTE_WORKTREE_ROOT}/route_B/results/route_B/controller_report.md",
        "${CARE_ROUTE_WORKTREE_ROOT}/route_B/results/route_B/completion_check.md"
      ]
    },
    "route_C": {
      "label": "Route C",
      "tmux_target": "${CARE_ROUTE_C_TMUX_TARGET}",
      "runtime_home_candidates": [
        "route_C_tmux_care_route_C__care_route_C",
        "route_C_tmux_care_route_C_controller__care_route_C_controller"
      ],
      "packet_paths": [
        "${CARE_ROUTE_WORKTREE_ROOT}/route_C/results/route_C/controller_report.md",
        "${CARE_ROUTE_WORKTREE_ROOT}/route_C/results/route_C/completion_check.md"
      ]
    }
  },
  "status_path": "controller_notifications/state/notify_goal_watcher_status.json",
  "log_path": "controller_notifications/logs/notify_goal_watcher.log",
  "tmux_session": "${CARE_NOTIFY_TMUX_SESSION}",
  "tmux_window": "${CARE_NOTIFY_TMUX_WINDOW}"
}
